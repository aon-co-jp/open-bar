{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-bar",
  "version": "0.1.1",
  "identifier": "jp.co.aon.open-bar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "open-bar",
        "width": 980,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "openbar"
        ]
      }
    }
  }
}